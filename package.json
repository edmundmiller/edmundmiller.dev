{
  "name": "edmundmiller-dev",
  "version": "4.3.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && tsx scripts/generate-site.ts && node scripts/generate-agent-content.mjs",
    "postbuild": "pagefind --site dist",
    "preview": "vite preview --outDir dist",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "wrangler": "wrangler",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "tsx scripts/compile-content.ts --production && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:stylex": "eslint \"src/**/*.stylex.{ts,tsx}\"",
    "lint:prose": "vale --no-global --config=.vale.ini src/content/post/",
    "test:vale": "node scripts/test-vale-style.mjs",
    "test:hooks": "bash scripts/codex-closeout-hook.test.sh",
    "test:site": "playwright test",
    "test:parity": "node scripts/check-parity.ts",
    "test:content": "tsx --test tests/content/*.test.ts",
    "test:app": "tsx scripts/compile-content.ts --production && vitest run",
    "skills:sync": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@foldkit/ui": "0.169.0",
    "@stylexjs/stylex": "0.19.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@wooorm/starry-night": "3.10.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "effect": "4.0.0",
    "evlog": "2.26.0",
    "foldkit": "0.169.0",
    "rehype-external-links": "3.0.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "0.7.10",
    "@foldkit/vite-plugin": "0.28.0",
    "@iconify-json/mdi": "1.2.3",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/node": "26.6.5",
    "autoprefixer": "10.5.2",
    "cf": "1.0.0-beta.20",
    "eslint": "9.39.5",
    "gray-matter": "4.0.3",
    "hast-util-to-text": "4.0.2",
    "mdast-util-to-string": "4.0.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "pagefind": "1.5.2",
    "postcss": "8.5.28",
    "postcss-html": "1.8.1",
    "postcss-import": "16.1.1",
    "reading-time": "1.5.0",
    "rehype-expressive-code": "0.44.3",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "remark-unwrap-images": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vite": "8.3.3",
    "vitest": "5.0.5",
    "wrangler": "4.143.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.8.0"
}
