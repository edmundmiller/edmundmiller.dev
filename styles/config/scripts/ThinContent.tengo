text := import("text")
frontmatter := text.re_find("(?s)^---.*?---", scope, 1)
is_draft := false
if !is_undefined(frontmatter) {
    fm := frontmatter[0][0]
    is_draft = !is_undefined(text.re_find(
        "(?mi)^draft:[\\t ]*true[\\t ]*$", scope[fm.begin:fm.end], 1))
}
document := text.re_replace("(?s)^---.*?---", scope, "")
document = text.re_replace("(?s)```.*?```|~~~.*?~~~", document, "")
document = text.re_replace("(?s)<[^>]*>", document, "")
words := text.re_find("[[:alnum:]][[:alnum:]'-]*", document, -1)
matches := []

if !is_draft && (is_undefined(words) || len(words) < 100) {
    matches = append(matches, {begin: 0, end: 1})
}
