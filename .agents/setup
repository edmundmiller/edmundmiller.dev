#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_version="24.17.0"
node_dir="$HOME/.local/share/node-v${node_version}"

case "$(uname -m)" in
  x86_64) node_arch="x64"; br_arch="amd64" ;;
  aarch64|arm64) node_arch="arm64"; br_arch="arm64" ;;
  *) printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
esac

step() {
  printf '\n==> %s\n' "$1"
}

step "Install Node.js ${node_version}"
if [[ ! -x "$node_dir/bin/node" ]]; then
  archive="node-v${node_version}-linux-${node_arch}.tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT
  curl --fail --location --silent --show-error --retry 3 \
    "https://nodejs.org/dist/v${node_version}/${archive}" \
    --output "$download_dir/$archive"
  curl --fail --location --silent --show-error --retry 3 \
    "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" \
    --output "$download_dir/SHASUMS256.txt"
  expected_checksum="$(awk -v archive="$archive" '$2 == archive { print $1 }' "$download_dir/SHASUMS256.txt")"
  [[ -n "$expected_checksum" ]]
  printf '%s  %s\n' "$expected_checksum" "$download_dir/$archive" | sha256sum --check --status

  mkdir -p "$(dirname "$node_dir")"
  tar -xJf "$download_dir/$archive" -C "$download_dir"
  rm -rf "$node_dir"
  mv "$download_dir/node-v${node_version}-linux-${node_arch}" "$node_dir"
  rm -rf "$download_dir"
  trap - EXIT
fi

export PATH="$node_dir/bin:$HOME/.local/bin:$PATH"

step "Activate pnpm 11.8.0"
corepack enable
corepack prepare pnpm@11.8.0 --activate

step "Install br issue tracker"
if ! br --version >/dev/null 2>&1; then
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --location --silent --show-error --retry 3 \
    https://raw.githubusercontent.com/Dicklesworthstone/beads_rust/main/install.sh \
    --output "$installer"
  release_json="$(curl --fail --location --silent --show-error --retry 3 \
    https://api.github.com/repos/Dicklesworthstone/beads_rust/releases/latest)"
  br_version="$(awk -F '"' '/"tag_name":/ { print $4; exit }' <<<"$release_json")"
  [[ "$br_version" =~ ^v[0-9] ]]
  br_archive="br-${br_version#v}-linux_musl_${br_arch}.tar.gz"
  bash "$installer" \
    --version "$br_version" \
    --artifact-url "https://github.com/Dicklesworthstone/beads_rust/releases/download/${br_version}/${br_archive}" \
    --skip-skills --no-gum --quiet
  br --version >/dev/null
  rm -f "$installer"
  trap - EXIT
fi

step "Persist the orb toolchain"
mkdir -p "$HOME/.local/bin"
for executable in node npm npx corepack pnpm pnpx; do
  ln -sfn "$node_dir/bin/$executable" "$HOME/.local/bin/$executable"
done

step "Install project dependencies"
cd "$repo_root"
corepack pnpm install --frozen-lockfile

step "Setup complete"
printf 'Node %s, pnpm %s, %s\n' "$(node --version)" "$(pnpm --version)" "$(br --version)"
