#!/usr/bin/env bash
set -euo pipefail

node_version="24.17.0"
export PATH="$HOME/.local/share/node-v${node_version}/bin:$HOME/.local/bin:$PATH"

printf 'Checking orb toolchain...\n'
[[ "$(node --version)" == "v${node_version}" ]]
[[ "$(pnpm --version)" == "11.8.0" ]]
br --version >/dev/null
printf 'Orb toolchain ready.\n'
