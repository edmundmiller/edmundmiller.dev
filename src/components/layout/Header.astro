---
import * as stylex from '@stylexjs/stylex';
import { menuLinks } from '@/site-config';
import Search from '@/components/search.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import { styles } from './Header.stylex';

const _url = new URL(Astro.request.url);
const styleAttributes = (...keys: Array<keyof typeof styles>) => ({
  ...stylex.attrs(...keys.map((key) => styles[key])),
  ...(import.meta.env.DEV ? { 'data-header-stylex': keys.join(' ') } : {}),
});
---

<header {...styleAttributes('header')} id="main-header">
  <div {...styleAttributes('identity')}>
    <a
      aria-current={_url.pathname === "/" ? "page" : false}
      {...styleAttributes('homeLink')}
      href="/"
    >
      <svg
        aria-hidden="true"
        {...styleAttributes('logo')}
        fill="none"
        focusable="false"
        viewBox="0 0 272 480"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Logo</title>
        <path
          d="M181.334 93.333v-40L226.667 80v40l-45.333-26.667ZM136.001 53.333 90.667 26.667v426.666L136.001 480V53.333Z"
          fill="#B04304"></path>
        <path
          d="m136.001 119.944 45.333-26.667 45.333 26.667-45.333 26.667-45.333-26.667ZM90.667 26.667 136.001 0l45.333 26.667-45.333 26.666-45.334-26.666ZM181.334 53.277l45.333-26.666L272 53.277l-45.333 26.667-45.333-26.667ZM0 213.277l45.333-26.667 45.334 26.667-45.334 26.667L0 213.277ZM136 239.944l-45.333-26.667v53.333L136 239.944Z"
          fill="#FF5D01"></path>
        <path
          d="m136 53.333 45.333-26.666v120L226.667 120V80L272 53.333V160l-90.667 53.333v240L136 480V306.667L45.334 360V240l45.333-26.667v53.334L136 240V53.333Z"
          fill="#53C68C"></path>
        <path d="M45.334 240 0 213.334v120L45.334 360V240Z" fill="#B04304"></path>
      </svg>
      <span {...styleAttributes('name')}>Edmund Miller</span>
    </a>
    <nav
      aria-label="Main menu"
      {...styleAttributes('navigation')}
      data-open="false"
      id="navigation-menu"
    >
      {
        menuLinks.map((link: { title: string; path: string }) => (
          <a
            aria-current={_url.pathname === link.path ? "page" : false}
            {...styleAttributes('menuLink')}
            data-astro-prefetch
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
    </nav>
  </div>
  <Search />
  <ThemeToggle />
  <mobile-button>
    <button
      aria-expanded="false"
      aria-haspopup="menu"
      aria-label="Open main menu"
      {...styleAttributes('menuButton')}
      id="toggle-navigation-menu"
      type="button"
    >
      <svg
        aria-hidden="true"
        {...styleAttributes('menuIcon')}
        data-open="false"
        fill="none"
        focusable="false"
        id="line-svg"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <svg
        aria-hidden="true"
        {...styleAttributes('menuIcon', 'closeIcon')}
        data-open="false"
        fill="none"
        focusable="false"
        id="cross-svg"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </mobile-button>
</header>

<script>
  import { styles as initialStyles } from "./Header.stylex";

  class MobileNavBtn extends HTMLElement {
    private menuOpen: boolean;
    private mobileButtonEl: HTMLButtonElement;
    private menuEl: HTMLElement;
    private menuIcons: NodeListOf<SVGElement>;

    toggleMobileMenu = () => {
      this.menuOpen = !this.menuOpen;
      this.mobileButtonEl.setAttribute("aria-expanded", this.menuOpen.toString());
      this.menuEl.dataset.open = this.menuOpen.toString();
      this.menuIcons.forEach((icon) => {
        icon.dataset.open = this.menuOpen.toString();
      });
    };

    constructor() {
      super();
      this.mobileButtonEl = this.querySelector("button") as HTMLButtonElement;
      this.menuEl = document.getElementById("navigation-menu")!;
      this.menuIcons = this.querySelectorAll("svg");
      this.menuOpen = false;

      this.mobileButtonEl.addEventListener("click", this.toggleMobileMenu);
    }
  }

  customElements.define("mobile-button", MobileNavBtn);

  if (import.meta.hot) {
    type HeaderStyles = typeof initialStyles;
    type StyleKey = keyof HeaderStyles;

    let currentStyles = initialStyles;

    const classTokens = (sheet: HeaderStyles, keys: StyleKey[]) => {
      const compiledStyles = Object.assign({}, ...keys.map((key) => sheet[key]));

      return Object.entries(compiledStyles)
        .filter(([property, value]) => property !== "$$css" && typeof value === "string")
        .flatMap(([, value]) => (value as string).split(/\s+/))
        .filter(Boolean);
    };

    import.meta.hot.accept("./Header.stylex", (nextModule) => {
      if (!nextModule) {
        return;
      }

      document.querySelectorAll<Element>("[data-header-stylex]").forEach((element) => {
        const keys = element.getAttribute("data-header-stylex")?.split(/\s+/) as
          | StyleKey[]
          | undefined;

        if (!keys?.length) {
          return;
        }

        element.classList.remove(...classTokens(currentStyles, keys));
        element.classList.add(...classTokens(nextModule.styles, keys));
      });

      currentStyles = nextModule.styles;
    });
  }
</script>
