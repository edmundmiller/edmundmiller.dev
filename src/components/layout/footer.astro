---
import * as stylex from '@stylexjs/stylex';
import { siteConfig, menuLinks } from '@/site-config';
import { styles } from './footer.stylex';

const _year = new Date().getFullYear();

const footerStyle = stylex.attrs(styles.footer);
const copyrightStyle = stylex.attrs(styles.copyright);
const creditStyle = stylex.attrs(styles.credit);
const navigationStyle = stylex.attrs(styles.navigation);
const navigationLinkStyle = stylex.attrs(styles.navigationLink);
---

<footer class={footerStyle.class} style={footerStyle.style}>
  <div class={copyrightStyle.class} style={copyrightStyle.style}>
    &copy; {siteConfig.author}
    {_year}.<span class={creditStyle.class} style={creditStyle.style}>&nbsp;🚀&nbsp;Astro Cactus</span>
  </div>
  <nav
    aria-label="More on this site"
    class={navigationStyle.class}
    style={navigationStyle.style}
  >
    {
      menuLinks.map((link: { title: string; path: string }) => (
        <a class={navigationLinkStyle.class} href={link.path} style={navigationLinkStyle.style}>
          {link.title}
        </a>
      ))
    }
  </nav>
</footer>
