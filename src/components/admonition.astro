---
import * as stylex from '@stylexjs/stylex';
import { styles } from './admonition.stylex';

interface Props {
  type?:
    | 'note'
    | 'tip'
    | 'info'
    | 'warning'
    | 'danger'
    | 'success'
    | 'example'
    | 'quote';
  title?: string;
  icon?: string;
  collapsible?: boolean;
  collapsed?: boolean;
}

const {
  type = 'note',
  title,
  icon,
  collapsible = false,
  collapsed = false,
} = Astro.props as Props;

// Define type configurations
const typeConfig = {
  note: {
    icon: icon || 'mdi:note-text',
    containerStyle: styles.noteContainer,
    iconStyle: styles.noteIcon,
    titleStyle: styles.noteTitle,
    defaultTitle: 'Note',
  },
  tip: {
    icon: icon || 'mdi:lightbulb',
    containerStyle: styles.tipContainer,
    iconStyle: styles.tipIcon,
    titleStyle: styles.tipTitle,
    defaultTitle: 'Tip',
  },
  info: {
    icon: icon || 'mdi:information',
    containerStyle: styles.infoContainer,
    iconStyle: styles.infoIcon,
    titleStyle: styles.infoTitle,
    defaultTitle: 'Info',
  },
  warning: {
    icon: icon || 'mdi:alert',
    containerStyle: styles.warningContainer,
    iconStyle: styles.warningIcon,
    titleStyle: styles.warningTitle,
    defaultTitle: 'Warning',
  },
  danger: {
    icon: icon || 'mdi:alert-octagon',
    containerStyle: styles.dangerContainer,
    iconStyle: styles.dangerIcon,
    titleStyle: styles.dangerTitle,
    defaultTitle: 'Danger',
  },
  success: {
    icon: icon || 'mdi:check-circle',
    containerStyle: styles.successContainer,
    iconStyle: styles.successIcon,
    titleStyle: styles.successTitle,
    defaultTitle: 'Success',
  },
  example: {
    icon: icon || 'mdi:file-document-edit',
    containerStyle: styles.exampleContainer,
    iconStyle: styles.exampleIcon,
    titleStyle: styles.exampleTitle,
    defaultTitle: 'Example',
  },
  quote: {
    icon: icon || 'mdi:format-quote-close',
    containerStyle: styles.quoteContainer,
    iconStyle: styles.quoteIcon,
    titleStyle: styles.quoteTitle,
    defaultTitle: 'Quote',
  },
};

const config = typeConfig[type];
const _displayTitle = title || config.defaultTitle;
const _uniqueId = `admonition-${Math.random().toString(36).substring(2, 11)}`;
const styleAttributes = (...keys: Array<keyof typeof styles>) => ({
  ...stylex.attrs(...keys.map((key) => styles[key])),
  ...(import.meta.env.DEV ? { 'data-admonition-stylex': keys.join(' ') } : {}),
});
// Keep Tailwind Typography dormant until Phase 5 removes the legacy plugin.
const _proseClass = ['pro', 'se'].join('');
---

<div
  class:list={[
    'admonition',
    `admonition-${type}`,
    styleAttributes('container').class,
    stylex.attrs(config.containerStyle).class,
  ]}
  data-type={type}
  data-admonition-stylex={import.meta.env.DEV ? `container ${type}Container` : undefined}
  style={styleAttributes('container').style}
>
  <div {...styleAttributes('header')}>
    <!-- Icon -->
    <div
      class:list={[styleAttributes('icon').class, stylex.attrs(config.iconStyle).class]}
      data-admonition-stylex={import.meta.env.DEV ? `icon ${type}Icon` : undefined}
      style={styleAttributes('icon').style}
    >
      <astro-icon name={config.icon} {...styleAttributes('iconGraphic')} />
    </div>

    <div {...styleAttributes('body')}>
      <!-- Title/Header -->
      {collapsible ? (
        <button
          class:list={[
            'admonition-toggle',
            styleAttributes('toggle').class,
            stylex.attrs(config.titleStyle).class,
          ]}
          data-admonition-stylex={import.meta.env.DEV ? `toggle ${type}Title` : undefined}
          aria-expanded={!collapsed}
          aria-controls={_uniqueId}
          style={styleAttributes('toggle').style}
        >
          <span>
            <span>{_displayTitle}</span>
          </span>
          <astro-icon
            name="mdi:chevron-down"
            {...styleAttributes('chevron')}
            data-expanded={(!collapsed).toString()}
          />
        </button>
      ) : (
        <div
          class:list={[
            styleAttributes('staticTitle').class,
            stylex.attrs(config.titleStyle).class,
          ]}
          data-admonition-stylex={import.meta.env.DEV ? `staticTitle ${type}Title` : undefined}
          style={styleAttributes('staticTitle').style}
        >
          {_displayTitle}
        </div>
      )}

      <!-- Content -->
      <div
        id={_uniqueId}
        class:list={[
          'admonition-content',
          styleAttributes('content', collapsible ? 'contentCollapsible' : 'content').class,
        ]}
        data-expanded={(!(collapsed && collapsible)).toString()}
        data-admonition-stylex={
          import.meta.env.DEV
            ? `content ${collapsible ? 'contentCollapsible' : ''}`.trim()
            : undefined
        }
        style={styleAttributes('content', collapsible ? 'contentCollapsible' : 'content').style}
      >
        <div class={_proseClass}>
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>

{collapsible && (
  <script>
    import { styles as initialStyles } from "./admonition.stylex";

    const browserWindow = window as Window & {
      __admonitionClickHandler?: (event: MouseEvent) => void;
    };

    if (browserWindow.__admonitionClickHandler) {
      document.removeEventListener("click", browserWindow.__admonitionClickHandler);
    }

    browserWindow.__admonitionClickHandler = (event) => {
      const toggle = (event.target as Element).closest<HTMLButtonElement>(".admonition-toggle");

      if (!toggle) return;

      const content = document.getElementById(toggle.getAttribute("aria-controls")!);
      const chevron = toggle.querySelector(
        'astro-icon[name="mdi:chevron-down"], [data-icon="mdi:chevron-down"]',
      );
      const expanded = toggle.getAttribute("aria-expanded") !== "true";

      toggle.setAttribute("aria-expanded", expanded.toString());
      content?.setAttribute("data-expanded", expanded.toString());
      chevron?.setAttribute("data-expanded", expanded.toString());
    };

    document.addEventListener("click", browserWindow.__admonitionClickHandler);

    if (import.meta.hot) {
      type AdmonitionStyles = typeof initialStyles;
      type StyleKey = keyof AdmonitionStyles;

      let currentStyles = initialStyles;

      const classTokens = (sheet: AdmonitionStyles, keys: StyleKey[]) => {
        const compiledStyles = Object.assign({}, ...keys.map((key) => sheet[key]));

        return Object.entries(compiledStyles)
          .filter(([property, value]) => property !== "$$css" && typeof value === "string")
          .flatMap(([, value]) => (value as string).split(/\s+/))
          .filter(Boolean);
      };

      import.meta.hot.accept("./admonition.stylex", (nextModule) => {
        if (!nextModule) return;

        document.querySelectorAll<Element>("[data-admonition-stylex]").forEach((element) => {
          const keys = element.getAttribute("data-admonition-stylex")?.split(/\s+/) as
            | StyleKey[]
            | undefined;

          if (!keys?.length) return;

          element.classList.remove(...classTokens(currentStyles, keys));
          element.classList.add(...classTokens(nextModule.styles, keys));
        });

        currentStyles = nextModule.styles;
      });
    }
  </script>
)}
