<dna-helix-header-orb aria-hidden="true">
  <img src="/dna-helix-avatar.jpg" alt="" decoding="async" />
  <canvas aria-hidden="true"></canvas>
</dna-helix-header-orb>

<script>
  type AvatarOrbDot = {
    depth: number;
    x: number;
    y: number;
  };

  const AVATAR_SIZE = 460;
  const MARK_BOUNDS = {
    height: 275,
    left: 135,
    top: 90,
    width: 190,
  } as const;
  const SAMPLE_STEP = 7;

  function deterministicUnitValue(x: number, y: number) {
    const value = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
    return value - Math.floor(value);
  }

  function sampleDnaHelixAvatar(image: HTMLImageElement) {
    const samplingCanvas = document.createElement('canvas');
    samplingCanvas.width = AVATAR_SIZE;
    samplingCanvas.height = AVATAR_SIZE;
    const context = samplingCanvas.getContext('2d', { willReadFrequently: true });
    if (!context) {
      return [];
    }

    context.drawImage(image, 0, 0, AVATAR_SIZE, AVATAR_SIZE);
    const pixels = context.getImageData(0, 0, AVATAR_SIZE, AVATAR_SIZE).data;
    const dots: AvatarOrbDot[] = [];

    for (let y = MARK_BOUNDS.top; y < MARK_BOUNDS.top + MARK_BOUNDS.height; y += SAMPLE_STEP) {
      for (
        let x = MARK_BOUNDS.left;
        x < MARK_BOUNDS.left + MARK_BOUNDS.width;
        x += SAMPLE_STEP
      ) {
        let darkestLuminance = 255;
        for (let sampleY = y - 2; sampleY <= y + 2; sampleY += 2) {
          for (let sampleX = x - 2; sampleX <= x + 2; sampleX += 2) {
            const pixelOffset = (sampleY * AVATAR_SIZE + sampleX) * 4;
            const red = pixels[pixelOffset] ?? 255;
            const green = pixels[pixelOffset + 1] ?? 255;
            const blue = pixels[pixelOffset + 2] ?? 255;
            darkestLuminance = Math.min(
              darkestLuminance,
              red * 0.2126 + green * 0.7152 + blue * 0.0722,
            );
          }
        }

        if (darkestLuminance >= 120) {
          continue;
        }

        dots.push({
          depth: deterministicUnitValue(x, y) * 2 - 1,
          x,
          y,
        });
      }
    }

    return dots.sort((left, right) => left.depth - right.depth);
  }

  /** Progressively enhances the static DNA avatar with a compact dot-orb animation. */
  class DnaHelixHeaderOrb extends HTMLElement {
    private animationFrame = 0;
    private avatarDots: AvatarOrbDot[] = [];
    private readonly canvas: HTMLCanvasElement;
    private readonly context: CanvasRenderingContext2D;
    private didEnhance = false;
    private height = 1;
    private readonly image: HTMLImageElement;
    private isVisible = true;
    private readonly motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    private readonly resizeObserver: ResizeObserver;
    private readonly visibilityObserver: IntersectionObserver;
    private width = 1;

    constructor() {
      super();
      this.canvas = this.querySelector('canvas')!;
      this.context = this.canvas.getContext('2d')!;
      this.image = this.querySelector('img')!;
      this.resizeObserver = new ResizeObserver(this.resizeHeaderOrb);
      this.visibilityObserver = new IntersectionObserver(this.updateVisibility);
    }

    connectedCallback() {
      this.resizeObserver.observe(this);
      this.visibilityObserver.observe(this);
      this.motionPreference.addEventListener('change', this.syncMotionPreference);
      document.addEventListener('visibilitychange', this.requestHeaderOrbFrame);
      this.resizeHeaderOrb();
      this.syncMotionPreference();
    }

    disconnectedCallback() {
      if (this.animationFrame) {
        cancelAnimationFrame(this.animationFrame);
      }
      this.image.removeEventListener('load', this.handleAvatarLoad);
      this.resizeObserver.disconnect();
      this.visibilityObserver.disconnect();
      this.motionPreference.removeEventListener('change', this.syncMotionPreference);
      document.removeEventListener('visibilitychange', this.requestHeaderOrbFrame);
    }

    private readonly drawHeaderOrb = (time: number) => {
      this.animationFrame = 0;
      this.context.clearRect(0, 0, this.width, this.height);

      const shortestSide = Math.min(this.width, this.height);
      const centerX = this.width / 2;
      const centerY = this.height / 2;
      const isDarkMode = document.documentElement.classList.contains('dark');
      const scale = (shortestSide * 0.96) / MARK_BOUNDS.height;
      const breath = 1 + Math.sin(time * 0.0018) * 0.025;
      const tilt = Math.sin(time * 0.00045) * 0.14;

      for (const dot of this.avatarDots) {
        const sourceX = (dot.x - (MARK_BOUNDS.left + MARK_BOUNDS.width / 2)) * scale * breath;
        const sourceY = (dot.y - (MARK_BOUNDS.top + MARK_BOUNDS.height / 2)) * scale * breath;
        const depthOffset = dot.depth * shortestSide * 0.045;
        const x = centerX + sourceX * Math.cos(tilt) + depthOffset * Math.sin(tilt);
        const y = centerY + sourceY + depthOffset * 0.06;
        const signal = (Math.sin(dot.x * 0.025 + dot.y * 0.018 - time * 0.0022) + 1) / 2;
        const radius = Math.max(0.42, shortestSide * (0.0075 + signal * 0.0035));

        this.context.beginPath();
        this.context.fillStyle = isDarkMode
          ? signal > 0.78
            ? '#ffd08a'
            : '#ff7a1a'
          : signal > 0.78
            ? '#ff5d01'
            : '#8f3b0b';
        this.context.globalAlpha = 0.55 + signal * 0.45;
        this.context.shadowBlur = 0;
        this.context.arc(x, y, radius, 0, Math.PI * 2);
        this.context.fill();
      }

      this.context.globalAlpha = 1;
      this.context.shadowBlur = 0;
      if (!this.didEnhance) {
        this.didEnhance = true;
        this.dataset.enhanced = 'true';
      }

      if (this.isVisible && !document.hidden && !this.motionPreference.matches) {
        this.animationFrame = requestAnimationFrame(this.drawHeaderOrb);
      }
    };

    private readonly handleAvatarLoad = () => {
      this.avatarDots = sampleDnaHelixAvatar(this.image);
      this.drawHeaderOrb(performance.now());
    };

    private readonly loadAvatarDots = () => {
      if (this.avatarDots.length > 0) {
        return;
      }
      if (this.image.complete) {
        this.handleAvatarLoad();
      } else {
        this.image.addEventListener('load', this.handleAvatarLoad, { once: true });
      }
    };

    private readonly requestHeaderOrbFrame = () => {
      if (
        this.avatarDots.length > 0 &&
        !(
          this.animationFrame ||
          document.hidden ||
          this.motionPreference.matches ||
          !this.isVisible
        )
      ) {
        this.animationFrame = requestAnimationFrame(this.drawHeaderOrb);
      }
    };

    private readonly resizeHeaderOrb = () => {
      const bounds = this.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      this.width = Math.max(1, bounds.width);
      this.height = Math.max(1, bounds.height);
      this.canvas.width = Math.round(this.width * pixelRatio);
      this.canvas.height = Math.round(this.height * pixelRatio);
      this.context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      if (this.avatarDots.length > 0 && this.motionPreference.matches) {
        this.drawHeaderOrb(0);
      } else {
        this.requestHeaderOrbFrame();
      }
    };

    private readonly syncMotionPreference = () => {
      if (this.motionPreference.matches) {
        if (this.animationFrame) {
          cancelAnimationFrame(this.animationFrame);
          this.animationFrame = 0;
        }
        this.loadAvatarDots();
        if (this.avatarDots.length > 0) {
          this.drawHeaderOrb(0);
        }
      } else {
        this.loadAvatarDots();
        this.requestHeaderOrbFrame();
      }
    };

    private readonly updateVisibility = ([entry]: IntersectionObserverEntry[]) => {
      this.isVisible = entry?.isIntersecting ?? true;
      if (!this.isVisible && this.animationFrame) {
        cancelAnimationFrame(this.animationFrame);
        this.animationFrame = 0;
      } else {
        this.requestHeaderOrbFrame();
      }
    };
  }

  if (!customElements.get('dna-helix-header-orb')) {
    customElements.define('dna-helix-header-orb', DnaHelixHeaderOrb);
  }
</script>

<style>
  dna-helix-header-orb {
    position: relative;
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    margin-inline-end: 0.75rem;
    overflow: hidden;
    border-radius: 50%;
  }

  img,
  canvas {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
  }

  img {
    object-fit: cover;
    transition: opacity 150ms ease-out;
  }

  canvas {
    display: block;
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  dna-helix-header-orb[data-enhanced='true'] img {
    opacity: 0;
  }

  dna-helix-header-orb[data-enhanced='true'] canvas {
    opacity: 1;
  }

  @media (min-width: 640px) {
    dna-helix-header-orb {
      position: absolute;
      width: 4rem;
      height: 4rem;
      inset-block-start: -0.75rem;
      inset-inline-start: -4.5rem;
      margin-inline-end: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }

    canvas {
      transition: none;
    }
  }
</style>
