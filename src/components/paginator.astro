---
import * as stylex from '@stylexjs/stylex';
import type { PaginationLink } from '@/types';
import { styles } from './paginator.stylex';

interface Props {
  nextUrl?: PaginationLink;
  prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props as Props;

const navigationStyle = stylex.attrs(styles.navigation);
const previousLinkStyle = stylex.attrs(styles.previousLink);
const nextLinkStyle = stylex.attrs(styles.nextLink);
const accessibleLabelStyle = stylex.attrs(styles.accessibleLabel);
---

{
  (prevUrl || nextUrl) && (
    <nav class={navigationStyle.class} style={navigationStyle.style}>
      {prevUrl && (
        <a
          class={previousLinkStyle.class}
          data-astro-prefetch
          href={prevUrl.url}
          style={previousLinkStyle.style}
        >
          {prevUrl.srLabel && (
            <span class={accessibleLabelStyle.class} style={accessibleLabelStyle.style}>
              {prevUrl.srLabel}
            </span>
          )}
          {prevUrl.text ? prevUrl.text : "Previous"}
        </a>
      )}
      {nextUrl && (
        <a
          class={nextLinkStyle.class}
          data-astro-prefetch
          href={nextUrl.url}
          style={nextLinkStyle.style}
        >
          {nextUrl.srLabel && (
            <span class={accessibleLabelStyle.class} style={accessibleLabelStyle.style}>
              {nextUrl.srLabel}
            </span>
          )}
          {nextUrl.text ? nextUrl.text : "Next"}
        </a>
      )}
    </nav>
  )
}
