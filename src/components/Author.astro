---
import * as stylex from '@stylexjs/stylex';
import type { AuthorInfo } from '../utils/github';
import { styles } from './author.stylex';

interface Props {
  author: AuthorInfo;
  showAvatar?: boolean;
  showBio?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const {
  author,
  showAvatar = false,
  showBio = false,
  size = 'sm',
} = Astro.props as Props;

const _authorStyle = stylex.attrs(styles.author);
const _avatarStyle = stylex.attrs(
  styles.avatar,
  size === 'sm' && styles.avatarSmall,
  size === 'md' && styles.avatarMedium,
  size === 'lg' && styles.avatarLarge,
);
const _profileLinkStyle = stylex.attrs(
  styles.profileLink,
  size === 'sm' && styles.textSmall,
  size === 'md' && styles.textMedium,
  size === 'lg' && styles.textLarge,
);
const _displayNameStyle = stylex.attrs(
  styles.displayName,
  size === 'sm' && styles.textSmall,
  size === 'md' && styles.textMedium,
  size === 'lg' && styles.textLarge,
);
const _bioStyle = stylex.attrs(styles.bio);

// Escape underscores to prevent markdown interpretation
const _escapedUsername = author.username.replace(/_/g, '\\_');
---

<div class:list={['author-info', _authorStyle.class]} style={_authorStyle.style}>
  {
    showAvatar && author.avatarUrl && (
      <img
        src={author.avatarUrl}
        alt={`${author.displayName} avatar`}
        class={_avatarStyle.class}
        loading="lazy"
        style={_avatarStyle.style}
      />
    )
  }

  <div class="author-details">
    <a
      href={author.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={_profileLinkStyle.class}
      title={`View ${author.displayName}'s GitHub profile`}
      style={_profileLinkStyle.style}
      set:html={`@${_escapedUsername}`}
    />

    {
      author.displayName !== author.username && (
        <span class={_displayNameStyle.class} style={_displayNameStyle.style}>
          ({author.displayName})
        </span>
      )
    }

    {
      showBio && author.bio && (
        <p class={_bioStyle.class} style={_bioStyle.style}>{author.bio}</p>
      )
    }
  </div>
</div>
