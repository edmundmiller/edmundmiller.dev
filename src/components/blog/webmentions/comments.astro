---
import * as stylex from '@stylexjs/stylex';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { WebmentionsChildren } from '@/types';
import { styles } from './comments.stylex';

interface Props {
  mentions: WebmentionsChildren[];
}

const { mentions } = Astro.props as Props;

const validComments = ['mention-of', 'in-reply-to'];

const comments = mentions.filter(
  (mention) =>
    validComments.includes(mention['wm-property']) && mention.content?.text
);

const summaryStyle = stylex.attrs(styles.summary);
const listStyle = stylex.attrs(styles.list);
const commentStyle = stylex.attrs(styles.comment);
const profileLinkStyle = stylex.attrs(styles.profileLink);
const avatarStyle = stylex.attrs(styles.avatar);
const unlinkedAvatarStyle = stylex.attrs(styles.avatar, styles.avatarWithoutLink);
const contentStyle = stylex.attrs(styles.content);
const commentHeaderStyle = stylex.attrs(styles.commentHeader);
const authorNameStyle = stylex.attrs(styles.authorName);
const sourceLinkStyle = stylex.attrs(styles.sourceLink);
const accessibleLabelStyle = stylex.attrs(styles.accessibleLabel);
const sourceIconStyle = stylex.attrs(styles.sourceIcon);
const commentTextStyle = stylex.attrs(styles.commentText);
---

{
  !!comments.length && (
    <div>
      <p class={summaryStyle.class} style={summaryStyle.style}>
        <strong>{comments.length}</strong> Mention{comments.length > 1 ? "s" : ""}
      </p>
      <ul class={listStyle.class} role="list" style={listStyle.style}>
        {comments.map((mention) => (
          <li class={commentStyle.class} style={commentStyle.style}>
            {mention.author?.photo && mention.author.photo !== "" ? (
              mention.author.url && mention.author.url !== "" ? (
                <a
                  class:list={['not-prose', profileLinkStyle.class]}
                  href={mention.author.url}
                  rel="noopener noreferrer"
                  style={profileLinkStyle.style}
                  target="_blank"
                  title={mention.author.name}
                >
                  <Image
                    alt={mention.author?.name}
                    class={avatarStyle.class}
                    height={48}
                    src={mention.author?.photo}
                    style={avatarStyle.style}
                    width={48}
                  />
                </a>
              ) : (
                <Image
                  alt={mention.author?.name}
                  class={unlinkedAvatarStyle.class}
                  height={48}
                  src={mention.author?.photo}
                  style={unlinkedAvatarStyle.style}
                  width={48}
                />
              )
            ) : null}
            <div class={contentStyle.class} style={contentStyle.style}>
              <div class={commentHeaderStyle.class} style={commentHeaderStyle.style}>
                <p class={authorNameStyle.class} style={authorNameStyle.style}>
                  {mention.author?.name}
                </p>
                <a
                  aria-labelledby="cmt-source"
                  class:list={['not-prose', sourceLinkStyle.class]}
                  href={mention.url}
                  rel="noopener noreferrer"
                  style={sourceLinkStyle.style}
                  target="_blank"
                >
                  <span
                    class={accessibleLabelStyle.class}
                    id="cmt-source"
                    style={accessibleLabelStyle.style}
                  >
                    Vist the source of this webmention
                  </span>
                  <Icon
                    aria-hidden="true"
                    class={sourceIconStyle.class}
                    focusable="false"
                    name="mdi:open-in-new"
                    style={sourceIconStyle.style}
                  />
                </a>
              </div>
              <p class={commentTextStyle.class} style={commentTextStyle.style}>
                {mention.content?.text}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}
