---
import * as stylex from '@stylexjs/stylex';
import type { CollectionEntry } from 'astro:content';
import type { HTMLTag, Polymorphic } from 'astro/types';
import FormattedDate from '@/components/formatted-date.astro';
import { styles } from './post-preview.stylex';

type Props<T extends HTMLTag> = Polymorphic<{ as: T }> & {
  post: CollectionEntry<'post'>;
  withDesc?: boolean;
};

const { as: Tag = 'div', post, withDesc = false } = Astro.props as Props<'div'>;
const _postDate = post.data.updatedDate ?? post.data.publishDate;
const _dateStyle = stylex.attrs(styles.date);
const _draftStyle = stylex.attrs(styles.draft);
const _titleLinkStyle = stylex.attrs(styles.titleLink);
const _descriptionStyle = stylex.attrs(styles.description);
---

<FormattedDate
  class:list={['dt-published', _dateStyle.class]}
  date={_postDate}
  style={_dateStyle.style}
/>
<Tag>
  {post.data.draft && <span class={_draftStyle.class} style={_draftStyle.style}>(Draft) </span>}
  <a
    class:list={['p-name', _titleLinkStyle.class]}
    data-astro-prefetch
    href={`/posts/${post.id}/`}
    style={_titleLinkStyle.style}
  >
    {post.data.title}
  </a>
</Tag>
{
  withDesc && (
    <q class:list={['p-summary', _descriptionStyle.class]} style={_descriptionStyle.style}>
      {post.data.description}
    </q>
  )
}
