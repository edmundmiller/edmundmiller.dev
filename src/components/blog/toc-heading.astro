---
import * as stylex from '@stylexjs/stylex';
import type { TocItem } from '@/utils';
import { styles } from './toc-heading.stylex';

interface Props {
  heading: TocItem;
}

const {
  heading: { depth, slug, children, text },
} = Astro.props as Props;

const _itemStyle = stylex.attrs(depth > 2 && styles.childItem);
const _anchorStyle = stylex.attrs(
  styles.anchor,
  depth <= 2 && styles.sectionAnchor,
  depth > 2 && styles.childAnchor,
);
const _markerStyle = stylex.attrs(styles.marker);
---

<li class={_itemStyle.class} style={_itemStyle.style}>
  <a
    aria-label={`Scroll to section: ${text}`}
    class={_anchorStyle.class}
    href={`#${slug}`}
    style={_anchorStyle.style}><span class={_markerStyle.class} style={_markerStyle.style}>#</span>{text}</a
  >
  {
    !!children.length && (
      <ul>
        {children.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
