---
import * as stylex from '@stylexjs/stylex';
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { createAuthorInfo } from '../../utils/github';
import { styles } from './hero.stylex';
import FormattedDate from '@/components/formatted-date.astro';
import Author from '@/components/author.astro';

interface Props {
  content: CollectionEntry<'post'>;
}

const { content } = Astro.props as Props;
const { data } = content;

const { remarkPluginFrontmatter } = await render(content);

const _dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'long',
};

// Handle authors - normalize to array and convert to AuthorInfo objects
let authors: string[];
if (data.author) {
  authors = Array.isArray(data.author) ? data.author : [data.author];
} else {
  authors = [];
}
const _authorInfos = authors.map((username) => createAuthorInfo(username));

const _coverStyle = stylex.attrs(styles.cover);
const _coverImageStyle = stylex.attrs(styles.coverImage);
const _draftStyle = stylex.attrs(styles.draft);
const _titleStyle = stylex.attrs(styles.title);
const _metaRowStyle = stylex.attrs(styles.metaRow);
const _publishedStyle = stylex.attrs(styles.published);
const _updatedStyle = stylex.attrs(styles.updated);
const _updatedDateStyle = stylex.attrs(styles.updatedDate);
const _authorsStyle = stylex.attrs(styles.authors);
const _authorIconStyle = stylex.attrs(styles.authorIcon);
const _authorLabelStyle = stylex.attrs(styles.authorLabel);
const _authorListStyle = stylex.attrs(styles.authorList);
const _authorItemStyle = stylex.attrs(styles.authorItem);
const _conjunctionStyle = stylex.attrs(styles.conjunction);
const _canonicalStyle = stylex.attrs(styles.canonical);
const _canonicalTextStyle = stylex.attrs(styles.canonicalText);
const _canonicalLabelStyle = stylex.attrs(styles.canonicalLabel);
const _canonicalLinkStyle = stylex.attrs(styles.cactusLink);
const _tagsStyle = stylex.attrs(styles.tags);
const _tagIconStyle = stylex.attrs(styles.tagIcon);
const _tagLinkStyle = stylex.attrs(styles.tagLink);
---

{
  data.coverImage && (
    <div class={_coverStyle.class} style={_coverStyle.style}>
      <Image
        alt={data.coverImage.alt}
        class={_coverImageStyle.class}
        fetchpriority="high"
        loading="eager"
        src={data.coverImage.src}
        style={_coverImageStyle.style}
      />
    </div>
  )
}
{data.draft ? <span class={_draftStyle.class} style={_draftStyle.style}>(Draft)</span> : null}
<h1 class:list={['p-name', _titleStyle.class]} style={_titleStyle.style}>
  {data.title}
</h1>
<div class={_metaRowStyle.class} style={_metaRowStyle.style}>
  <p class={_publishedStyle.class} style={_publishedStyle.style}>
    <FormattedDate date={data.publishDate} dateTimeOptions={_dateTimeOptions} class="dt-published" />
    /{" "}
    {remarkPluginFrontmatter.minutesRead}
  </p>
  {
    data.updatedDate && (
      <span class={_updatedStyle.class} style={_updatedStyle.style}>
        Last Updated:
        <FormattedDate
          class={_updatedDateStyle.class}
          date={data.updatedDate}
          dateTimeOptions={_dateTimeOptions}
          style={_updatedDateStyle.style}
        />
      </span>
    )
  }
</div>

{/* Authors section */}
{
  _authorInfos.length > 0 && (
    <div class={_authorsStyle.class} style={_authorsStyle.style}>
      <svg
        aria-hidden="true"
        class={_authorIconStyle.class}
        fill="none"
        focusable="false"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        style={_authorIconStyle.style}
      >
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
      <span class={_authorLabelStyle.class} style={_authorLabelStyle.style}
        >{_authorInfos.length === 1 ? "Author:" : "Authors:"}</span
      >
      <div class={_authorListStyle.class} style={_authorListStyle.style}>
        {_authorInfos.map((author, i) => (
          <div class={_authorItemStyle.class} style={_authorItemStyle.style}>
            <Author author={author} size="sm" />
            {i < _authorInfos.length - 1 && (
              <span class={_conjunctionStyle.class} style={_conjunctionStyle.style}>
                {_authorInfos.length === 2 ? "and" : i === _authorInfos.length - 2 ? ", and" : ","}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}

{/* Canonical URL section */}
{
  data.canonical && (
    <div class={_canonicalStyle.class} style={_canonicalStyle.style}>
      <svg
        aria-hidden="true"
        class={_authorIconStyle.class}
        fill="none"
        focusable="false"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        style={_authorIconStyle.style}
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <span class={_canonicalTextStyle.class} style={_canonicalTextStyle.style}>
        <span class={_canonicalLabelStyle.class} style={_canonicalLabelStyle.style}
          >Originally published at:</span
        >
        <a
          href={data.canonical}
          class={_canonicalLinkStyle.class}
          target="_blank"
          rel="noopener noreferrer"
          style={_canonicalLinkStyle.style}
        >
          {new URL(data.canonical).hostname}
        </a>
      </span>
    </div>
  )
}

{
  !!data.tags?.length && (
    <div class={_tagsStyle.class} style={_tagsStyle.style}>
      <svg
        aria-hidden="true"
        class={_tagIconStyle.class}
        fill="none"
        focusable="false"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        style={_tagIconStyle.style}
      >
        <path d="M0 0h24v24H0z" fill="none" stroke="none" />
        <path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
        <path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
        <path d="M6 9h-.01" />
      </svg>
      {data.tags.map((tag, i) => (
        <>
          <a
            aria-label={`View more blogs with the tag ${tag}`}
            class:list={['p-category', _tagLinkStyle.class]}
            data-pagefind-filter="tag"
            href={`/tags/${tag}/`}
            style={_tagLinkStyle.style}
          >
            {tag}
          </a>
          {i < data.tags.length - 1 && ", "}
        </>
      ))}
    </div>
  )
}
