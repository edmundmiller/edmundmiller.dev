---
import * as stylex from '@stylexjs/stylex';
import { styles } from './openring.stylex';

interface OpenringItem {
  title: string;
  link: string;
  summary: string;
  source_title: string;
  source_link: string;
  date: string;
}

// Mock data or import from actual openring data
const _openring: OpenringItem[] = [
  // Add your openring data here or import from a data file
];

const headingStyle = stylex.attrs(styles.heading);
const entriesStyle = stylex.attrs(styles.entries);
const entryStyle = stylex.attrs(styles.entry);
const entryTitleStyle = stylex.attrs(styles.entryTitle);
const summaryStyle = stylex.attrs(styles.summary);
const sourceStyle = stylex.attrs(styles.source);
const attributionStyle = stylex.attrs(styles.attribution);
---

{
  _openring.length > 0 && (
    <section>
      <h3 class={headingStyle.class} style={headingStyle.style}>On the Web</h3>
      <section class={entriesStyle.class} style={entriesStyle.style}>
        <div>
          {
            _openring.map(({ title, link, summary, source_title, source_link, date }) => (
              <div>
                <div>
                  <div>
                    <article class={entryStyle.class} style={entryStyle.style}>
                      <h2 class={entryTitleStyle.class} style={entryTitleStyle.style}>
                        <a href={link} target="_blank" rel="noopener">
                          {title}
                        </a>
                      </h2>
                      <p class={summaryStyle.class} style={summaryStyle.style}>{summary}</p>
                      <small class={sourceStyle.class} style={sourceStyle.style}>
                        by <a href={source_link}>{source_title}</a>
                      </small>
                      <small>{date}</small>
                    </article>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <p class={attributionStyle.class} style={attributionStyle.style}>
        Generated by <a href="https://git.sr.ht/~sircmpwn/openring">Open Ring</a>
      </p>
    </section>
  )
}
