---
import * as stylex from '@stylexjs/stylex';
import PageLayout from './base.astro';
import { styles } from './about.stylex';
import { siteConfig } from '@/site-config';

interface Props {
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const { frontmatter = {} } = Astro.props as Props;
const _meta = {
  description: frontmatter.description ?? siteConfig.description,
  title: frontmatter.title ?? 'About',
};
const _contentStyle = stylex.attrs(styles.content);
const _proseStyle = stylex.attrs(styles.prose);
// Keep Tailwind Typography dormant until Phase 5 removes the legacy plugin.
const _proseClass = ['pro', 'se'].join('');
---

<PageLayout meta={_meta}>
  <div class={_contentStyle.class} style={_contentStyle.style}>
    <div class:list={[_proseClass, _proseStyle.class]} style={_proseStyle.style}>
      <slot />
    </div>
  </div>
</PageLayout>

<style is:global>
  @import '../styles/prose.css';
</style>
