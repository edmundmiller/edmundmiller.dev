---
import * as stylex from '@stylexjs/stylex';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { getAllPosts, getUniqueTags, sortMDByDate } from '@/data/post';
import PageLayout from '@/layouts/base.astro';
import PostPreview from '@/components/blog/post-preview.astro';
import Paginator from '@/components/paginator.astro';
import { styles } from './_posts.stylex';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getAllPosts();
  const allPostsByDate = sortMDByDate(allPosts);
  const uniqueTags = getUniqueTags(allPosts);
  return paginate(allPostsByDate, { pageSize: 10, props: { uniqueTags } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'post'>>;
  uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props as Props;

const _meta = {
  description:
    'Posts by Edmund Miller about bioinformatics, genomics, Nextflow, nf-core, software engineering, Nix, Emacs, and reproducible workflows.',
  title: 'Posts',
};

const _paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Previous Posts',
      url: page.url.prev,
    },
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Next Posts →',
      url: page.url.next,
    },
  }),
};

const pageTitleStyle = stylex.attrs(styles.pageTitle);
const pageGridStyle = stylex.attrs(styles.pageGrid);
const postListStyle = stylex.attrs(styles.postList);
const postStyle = stylex.attrs(styles.post);
const sidebarHeadingStyle = stylex.attrs(styles.sidebarHeading);
const tagIconStyle = stylex.attrs(styles.tagIcon);
const tagListStyle = stylex.attrs(styles.tagList);
const tagLinkStyle = stylex.attrs(styles.tagLink);
const allTagsStyle = stylex.attrs(styles.allTags);
const allTagsLinkStyle = stylex.attrs(styles.allTagsLink);
---

<PageLayout meta={_meta}>
  <h1 class={pageTitleStyle.class} style={pageTitleStyle.style}>Posts</h1>
  <div class={pageGridStyle.class} style={pageGridStyle.style}>
    <section aria-label="Blog post list" class="h-feed">
      <ul class={postListStyle.class} style={postListStyle.style}>
        {
          page.data.map((p) => (
            <li class={postStyle.class} style={postStyle.style}>
              <PostPreview as="h2" post={p} withDesc />
            </li>
          ))
        }
      </ul>
      <Paginator {..._paginationProps} />
    </section>
    {
      !!uniqueTags.length && (
        <aside>
          <h2 class={sidebarHeadingStyle.class} style={sidebarHeadingStyle.style}>
            <svg
              aria-hidden="true"
              class={tagIconStyle.class}
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              style={tagIconStyle.style}
            >
              <path d="M0 0h24v24H0z" fill="none" stroke="none" />
              <path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
              <path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
              <path d="M6 9h-.01" />
            </svg>
            Tags
          </h2>
          <ul class={tagListStyle.class} style={tagListStyle.style}>
            {uniqueTags.map((tag) => (
              <li>
                <a
                  aria-label={`View all posts with the tag: ${tag}`}
                  class:list={['p-category', tagLinkStyle.class]}
                  href={`/tags/${tag}/`}
                  style={tagLinkStyle.style}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
          <span class={allTagsStyle.class} style={allTagsStyle.style}>
            <a
              aria-label="View all blog categories"
              class:list={['p-category', allTagsLinkStyle.class]}
              href="/tags/"
              style={allTagsLinkStyle.style}
            >
              View all →
            </a>
          </span>
        </aside>
      )
    }
  </div>
</PageLayout>
