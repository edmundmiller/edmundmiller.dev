---
import * as stylex from '@stylexjs/stylex';
import PageLayout from '@/layouts/base.astro';
import { styles } from './_404.stylex';

const _meta = {
  description:
    'This page was not found. Use the site navigation to find Edmund Miller posts, talks, and bioinformatics notes.',
  robots: 'noindex, follow',
  title: 'Oops! You found a missing page!',
};

const pageTitleStyle = stylex.attrs(styles.pageTitle);
const guidanceStyle = stylex.attrs(styles.guidance);
const imageFrameStyle = stylex.attrs(styles.imageContainer);
---

<PageLayout meta={_meta}>
  <h1 class={pageTitleStyle.class} style={pageTitleStyle.style}>
    404 | Oops something went wrong
  </h1>
  <p class={guidanceStyle.class} style={guidanceStyle.style}>
    Please use the navigation to find your way back
  </p>
  <div class={imageFrameStyle.class} style={imageFrameStyle.style}>
    <img
      alt="A juggler doing the boston mess pattern"
      loading="eager"
      src="https://libraryofjuggling.com/JugglingGifs/3balltricks/bostonmess.gif"
    />
  </div>
</PageLayout>
