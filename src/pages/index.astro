---
import '@fontsource-variable/roboto-mono';
import { getAllPosts, sortMDByDate } from '@/data/post';
import PageLayout from '@/layouts/base.astro';
import PostPreview from '@/components/blog/post-preview.astro';
import Openring from '@/components/openring.astro';
import PipelineField from '@/components/pipeline-field';
import WritingCadenceChart from '@/components/writing-cadence-chart';

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const _allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
const postsByYear = Array.from(
  allPosts.reduce((years, post) => {
    const year = String(post.data.publishDate.getFullYear());
    years.set(year, (years.get(year) ?? 0) + 1);
    return years;
  }, new Map<string, number>()),
  ([year, posts]) => ({ year, posts }),
).sort((a, b) => a.year.localeCompare(b.year));
const _meta = {
  description:
    'Bioinformatics engineer and PhD candidate writing about Nextflow, nf-core, functional genomics, reproducible workflows, and software for data-intensive science.',
  title: 'Bioinformatics Engineer — Nextflow & nf-core',
};

/* Tech stack info (unused for now)
const cactusTech: { desc: string; href: string; title: string }[] = [
  {
    desc: 'Build fast websites, faster.',
    href: 'https://astro.build',
    title: 'Astro',
  },
  {
    desc: 'Rapidly build modern websites without ever leaving your HTML.',
    href: 'https://tailwindcss.com',
    title: 'Tailwind CSS',
  },
  {
    desc: 'Simple and easy-to-use markup language.',
    href: 'https://www.markdownguide.org/',
    title: 'Markdown',
  },
  {
    desc: 'Markdown for the component era.',
    href: 'https://mdxjs.com/',
    title: 'MDX',
  },
  {
    desc: 'Generating png Open Graph images for blog posts.',
    href: 'https://github.com/vercel/satori',
    title: 'Satori',
  },
  {
    desc: 'A fully static search library.',
    href: 'https://pagefind.app/',
    title: 'Pagefind',
  },
  {
    desc: 'An easy to use Icon component for Astro.',
    href: 'https://github.com/natemoo-re/astro-icon#readme',
    title: 'Astro Icon',
  },
  {
    desc: 'Highly customisable source code & syntax highlighter',
    href: 'https://expressive-code.com/',
    title: 'Expressive Code',
  },
];
*/
---

<PageLayout meta={_meta}>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__stage">
      <p class="home-hero__eyebrow">Functional genomics · workflow engineering</p>
      <div class="home-hero__layout">
        <div class="home-hero__copy">
          <h1 id="home-hero-title" class="home-hero__title">I make biological data move.</h1>
          <p class="home-hero__support">
            I’m Edmund Miller, a bioinformatics engineer and PhD candidate building reproducible
            pipelines for functional genomics—and writing down what survives contact with real data.
          </p>
          <nav class="home-hero__actions" aria-label="Homepage shortcuts">
            <a
              class="home-hero__action home-hero__action--primary"
              data-goatcounter-event="home-start-posts"
              href="/posts/"
            >
              Read the work
            </a>
            <a
              class="home-hero__action"
              data-goatcounter-event="home-start-speaking"
              href="/speaking/"
            >
              See the talks
            </a>
          </nav>
        </div>
        <div class="home-hero__pipeline">
          <PipelineField client:visible />
        </div>
      </div>
    </div>
  </section>
  <section class="home-intro" aria-labelledby="home-intro-title">
    <h2 id="home-intro-title" class="title mb-3 text-xl">From bench to pipelines</h2>
    <p>
      I got into bioinformatics after realizing I didn’t have golden hands at the bench. Programming
      stuck; now I build reproducible, high-throughput workflows with Nextflow and nf-core.
    </p>
  </section>
  <section aria-label="Blog post list" class="mt-16">
    <h2 class="h-feed title mb-4 text-xl">Posts</h2>
    <figure class="mb-10 border-y border-dashed border-textColor/30 py-5">
      <figcaption class="mb-3 text-sm text-textColor/70">Writing cadence · posts per year</figcaption>
      <WritingCadenceChart data={postsByYear} client:visible />
    </figure>
    <ul class="space-y-4">
      {
        _allPostsByDate.map((p) => (
            <li class="flex flex-col gap-x-2 sm:flex-row">
              <PostPreview post={p} withDesc />
            </li>
        ))
      }
    </ul>
    <a href="/posts/" class="mt-6 inline-flex items-center gap-1 text-sm cactus-link">
      View all posts
      <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
  <section class="mt-16"></section>
  <Openring />
</PageLayout>

<style>
  .home-hero {
    width: min(70rem, calc(100vw - 2rem));
    margin-inline: 50%;
    transform: translateX(-50%);
  }

  .home-hero__stage {
    position: relative;
    overflow: hidden;
    border: 1px solid #141718;
    background: #030303;
    color: #f5f6f3;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .home-hero__stage::before,
  .home-hero__stage::after {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border-color: #35d19a;
    content: '';
    pointer-events: none;
  }

  .home-hero__stage::before {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .home-hero__stage::after {
    right: 0.75rem;
    bottom: 0.75rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .home-hero__eyebrow {
    margin: 0 0 clamp(2rem, 5vw, 4.5rem);
    color: #8b9499;
    font-family: 'Geist Pixel Square', ui-monospace, monospace;
    font-size: 0.75rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .home-hero__copy,
  .home-hero__pipeline {
    min-width: 0;
  }

  .home-hero__title {
    max-width: 9ch;
    margin: 0;
    color: #f5f6f3;
    font-family: 'Geist Pixel Grid', 'Geist Pixel Square', ui-monospace, monospace;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 0.94;
    text-wrap: balance;
  }

  .home-hero__support {
    max-width: 38rem;
    margin: 1.75rem 0 0;
    color: #8b9499;
    font-family: 'Roboto Mono Variable', 'Roboto Mono', ui-monospace, monospace;
    font-size: clamp(0.875rem, 1.4vw, 1rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .home-hero__action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #8b9499;
    color: #f5f6f3;
    padding: 0.625rem 1rem;
    font-family: 'Geist Pixel Square', ui-monospace, monospace;
    font-size: 0.75rem;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color 150ms ease-out,
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .home-hero__action:hover {
    border-color: #f5f6f3;
    background: #141718;
  }

  .home-hero__action--primary {
    border-color: #35d19a;
    background: #35d19a;
    color: #030303;
  }

  .home-hero__action--primary:hover {
    border-color: #f5f6f3;
    background: #f5f6f3;
  }

  .home-hero__action:focus-visible {
    outline: 2px solid #35d19a;
    outline-offset: 3px;
  }

  .home-intro {
    margin-top: 3rem;
  }

  .home-intro p {
    font-family: 'Roboto Mono Variable', 'Roboto Mono', ui-monospace, monospace;
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (max-width: 639px) {
    .home-hero__stage {
      padding: 1.5rem 1.25rem;
    }

    .home-hero__eyebrow {
      max-width: 24rem;
      margin-bottom: 2.5rem;
    }

    .home-hero__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .home-hero__title {
      max-width: 8ch;
      font-size: clamp(2.6rem, 13vw, 3.6rem);
    }

    .home-hero__pipeline {
      margin-inline: -0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {

    .home-hero__action {
      transition: none;
    }
  }
</style>
