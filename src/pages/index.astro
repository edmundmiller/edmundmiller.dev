---
import * as stylex from '@stylexjs/stylex';
import { getAllPosts, sortMDByDate } from '@/data/post';
import PageLayout from '@/layouts/base.astro';
import SocialList from '@/components/social-list.astro';
import PostPreview from '@/components/blog/post-preview.astro';
import Openring from '@/components/openring.astro';
import WritingCadenceChart from '@/components/writing-cadence-chart';
import { styles } from './_index.stylex';

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const _allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
const postsByYear = Array.from(
  allPosts.reduce((years, post) => {
    const year = String(post.data.publishDate.getFullYear());
    years.set(year, (years.get(year) ?? 0) + 1);
    return years;
  }, new Map<string, number>()),
  ([year, posts]) => ({ year, posts }),
).sort((a, b) => a.year.localeCompare(b.year));
const _meta = {
  description:
    'Bioinformatics engineer and PhD candidate writing about Nextflow, nf-core, functional genomics, reproducible workflows, and software for data-intensive science.',
  title: 'Bioinformatics Engineer — Nextflow & nf-core',
};

const introductionTitleStyle = stylex.attrs(styles.introductionTitle);
const introductionParagraphStyle = stylex.attrs(styles.introductionParagraph);
const introductionClosingStyle = stylex.attrs(styles.introductionClosing);
const startHereStyle = stylex.attrs(styles.startHere);
const sectionTitleStyle = stylex.attrs(styles.sectionTitle);
const startHereDescriptionStyle = stylex.attrs(styles.startHereDescription);
const startHereLinksStyle = stylex.attrs(styles.startHereLinks);
const cactusLinkStyle = stylex.attrs(styles.cactusLink);
const postsStyle = stylex.attrs(styles.posts);
const cadenceStyle = stylex.attrs(styles.cadence);
const cadenceCaptionStyle = stylex.attrs(styles.cadenceCaption);
const postListStyle = stylex.attrs(styles.postList);
const postStyle = stylex.attrs(styles.post);
const allPostsLinkStyle = stylex.attrs(styles.cactusLink, styles.allPostsLink);
const openringSpacingStyle = stylex.attrs(styles.openringSpacing);
---

<PageLayout meta={_meta}>
  <section>
    <h1 class={introductionTitleStyle.class} style={introductionTitleStyle.style}>Hello!</h1>
    <p class={introductionParagraphStyle.class} style={introductionParagraphStyle.style}>
      I'm <a href="https://edmundmiller.dev/" class="h-card" rel="me">Edmund Miller</a>, a PhD
      candidate with a broad range of interests, primarily in Functional Genomics. I got into
      bioinformatics after realizing I didn't have golden hands at the bench during undergrad.
    </p>
    <p class={introductionParagraphStyle.class} style={introductionParagraphStyle.style}>
      That taste of programming got me dabbling in writing smart contracts and web apps. Through my
      research experience I acquired a taste for processing data with reproducible, high-throughput
      workflows.
    </p>
    <p class={introductionClosingStyle.class} style={introductionClosingStyle.style}>
      I saw the light in March 2020 when I found <a href="https://nf-co.re/">nf-core</a> and tossed
      aside the reptilian workflow manager for <a href="https://www.nextflow.io/">Nextflow</a>. I love
      a good crossover episode of technologies and I'm always trying to push the envelope.
    </p>
    <SocialList />
  </section>
  <section aria-labelledby="start-here" class={startHereStyle.class} style={startHereStyle.style}>
    <h2 class={sectionTitleStyle.class} id="start-here" style={sectionTitleStyle.style}>Start here</h2>
    <p class={startHereDescriptionStyle.class} style={startHereDescriptionStyle.style}>
      If you're here for bioinformatics tooling, reproducible workflows, or Emacs-shaped developer
      ergonomics, these are the best next steps.
    </p>
    <div class={startHereLinksStyle.class} style={startHereLinksStyle.style}>
      <a
        class={cactusLinkStyle.class}
        style={cactusLinkStyle.style}
        data-goatcounter-event="home-start-posts"
        href="/posts/"
      >
        Read the technical posts
      </a>
      <a
        class={cactusLinkStyle.class}
        style={cactusLinkStyle.style}
        data-goatcounter-event="home-start-speaking"
        href="/speaking/"
      >
        See conference talks
      </a>
      <a
        class={cactusLinkStyle.class}
        style={cactusLinkStyle.style}
        data-goatcounter-event="home-start-about"
        href="/about/"
      >
        Learn what I'm working on
      </a>
    </div>
  </section>
  <section aria-label="Blog post list" class={postsStyle.class} style={postsStyle.style}>
    <h2 class:list={['h-feed', sectionTitleStyle.class]} style={sectionTitleStyle.style}>Posts</h2>
    <figure class={cadenceStyle.class} style={cadenceStyle.style}>
      <figcaption class={cadenceCaptionStyle.class} style={cadenceCaptionStyle.style}>Writing cadence · posts per year</figcaption>
      <WritingCadenceChart data={postsByYear} client:visible />
    </figure>
    <ul class={postListStyle.class} style={postListStyle.style}>
      {
        _allPostsByDate.map((p) => (
            <li class={postStyle.class} style={postStyle.style}>
              <PostPreview post={p} withDesc />
            </li>
        ))
      }
    </ul>
    <a
      href="/posts/"
      class={allPostsLinkStyle.class}
      style={allPostsLinkStyle.style}
    >
      View all posts
      <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
  <section class={openringSpacingStyle.class} style={openringSpacingStyle.style}></section>
  <Openring />
</PageLayout>
