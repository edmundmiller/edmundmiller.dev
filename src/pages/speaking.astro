---
import * as stylex from '@stylexjs/stylex';
import PageLayout from '@/layouts/base.astro';
import { getFormattedDate } from '@/utils';
import { contentData } from '@/data/content.json';
import { styles } from './_speaking.stylex';

// Sort talks by date descending (newest first)
const _content = contentData.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const _meta = {
  description:
    "Conference talks by Edmund Miller about bioinformatics, nf-core, Nextflow, functional genomics, and reproducible scientific workflows.",
  title: 'Speaking',
};

const pageStyle = stylex.attrs(styles.page);
const contentStyle = stylex.attrs(styles.content);
const pageTitleStyle = stylex.attrs(styles.pageTitle);
const introductionStyle = stylex.attrs(styles.introduction);
const talkListStyle = stylex.attrs(styles.talkList);
const talkStyle = stylex.attrs(styles.talk);
const talkMetaStyle = stylex.attrs(styles.talkMeta);
const metadataStyle = stylex.attrs(styles.metadata);
const videoLinkStyle = stylex.attrs(styles.videoLink);
const talkContentStyle = stylex.attrs(styles.talkContent);
const talkTitleStyle = stylex.attrs(styles.talkTitle);
const talkTitleTextStyle = stylex.attrs(styles.talkTitle, styles.talkTitleText);
const talkTitleLinkStyle = stylex.attrs(styles.talkTitleLink);
const eventStyle = stylex.attrs(styles.event);
const descriptionStyle = stylex.attrs(styles.description);
const emptyStateStyle = stylex.attrs(styles.emptyState);
const emptyStateTextStyle = stylex.attrs(styles.emptyStateText);
const cactusLinkStyle = stylex.attrs(styles.cactusLink);
---

<PageLayout meta={_meta}>
  <!--
// v0 by Vercel.
// https://v0.dev/t/xhsg8l1j1aQ
-->
  <div class={pageStyle.class} style={pageStyle.style}>
    <div class={contentStyle.class} style={contentStyle.style}>
      <div>
        <h1 class={pageTitleStyle.class} style={pageTitleStyle.style}>My Conference Talks</h1>
        <p class={introductionStyle.class} style={introductionStyle.style}>
          A collection of talks I've given at various conferences.
        </p>
      </div>
      <section aria-label="Talk list" class="h-feed">
        {_content.length > 0 ? (
          <div class={talkListStyle.class} style={talkListStyle.style}>
            {
              _content.map(({ href, videoHref, event, title, date, location, desc }) => (
                <div class={talkStyle.class} style={talkStyle.style}>
                  <div class={talkMetaStyle.class} style={talkMetaStyle.style}>
                    {date && (
                      <time
                        datetime={date}
                        class={metadataStyle.class}
                        style={metadataStyle.style}
                      >
                        {getFormattedDate(date)}
                      </time>
                    )}
                    {videoHref && (
                      <a
                        href={videoHref}
                        class={videoLinkStyle.class}
                        style={videoLinkStyle.style}
                      >
                        Watch Video
                      </a>
                    )}
                  </div>
                  <div class={talkContentStyle.class} style={talkContentStyle.style}>
                    {href ? (
                      <h2 class={talkTitleStyle.class} style={talkTitleStyle.style}>
                        <a href={href} class={talkTitleLinkStyle.class} style={talkTitleLinkStyle.style}>{title}</a>
                      </h2>
                    ) : (
                      <h2
                        class={talkTitleTextStyle.class}
                        style={talkTitleTextStyle.style}
                      >{title}</h2>
                    )}
                    <p class={eventStyle.class} style={eventStyle.style}>
                      {event}, {location}
                    </p>
                    {desc && (
                      <p class={descriptionStyle.class} style={descriptionStyle.style}>{desc}</p>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        ) : (
          <div class={emptyStateStyle.class} style={emptyStateStyle.style}>
            <p class={emptyStateTextStyle.class} style={emptyStateTextStyle.style}>
              Talks coming soon! In the meantime, check out my <a
                href="/posts/"
                class={cactusLinkStyle.class}
                style={cactusLinkStyle.style}
              >blog posts</a>.
            </p>
          </div>
        )}
      </section>
    </div>
  </div>
</PageLayout>
